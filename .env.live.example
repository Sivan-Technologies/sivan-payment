# Sivan Payments API — LIVE lane (Render)
APP_ENV=production
PORT=10000
APP_URL=https://sivan-payments-api-live.onrender.com
CORS_ORIGIN=https://app.sivantech.online,https://admin.sivantech.online
LOG_LEVEL=info

# Admin / auth
ADMIN_API_KEY=
USER_JWT_SECRET=
USER_JWT_EXPIRES_MINUTES=60
AUTH_OTP_EXPIRES_MINUTES=10
AUTH_DEV_SHOW_OTP=false
AUTH_REQUIRE_USER=true

# Email provider
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM="Sivan <no-reply@sivantech.online>"
LEGAL_TERMS_VERSION=2026-07-14
LEGAL_PRIVACY_VERSION=2026-07-14
LEGAL_RISK_DISCLOSURE_VERSION=2026-07-14

# Error monitoring
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_MAX_PER_MINUTE=120
RATE_LIMIT_ADMIN_MAX_PER_MINUTE=300
RATE_LIMIT_WEBHOOK_MAX_PER_MINUTE=300
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_START_MAX=5
RATE_LIMIT_AUTH_VERIFY_MAX=20

# Database
DATABASE_PROVIDER=postgres
DATABASE_URL=
DATABASE_FILE=.data/sivan-payments-live.json

# Bridge production
BRIDGE_MOCK_MODE=false
DEFAULT_OFFRAMP_PROVIDER=bridge
BRIDGE_BASE_URL=https://api.bridge.xyz/v0
BRIDGE_API_KEY=
BRIDGE_WEBHOOK_PUBLIC_KEY=
BRIDGE_WEBHOOK_ID=
WEBHOOK_MAX_AGE_MS=600000

# Fees / costs
SIVAN_OFFRAMP_FEE_PERCENT=1.25
BRIDGE_OFFRAMP_COST_PERCENT=0.5
BRIDGE_KYC_COST_USD=2
BRIDGE_KYB_COST_USD=10
CUSTOMER_ACQUISITION_COST_USD=0

# Shared customer identity linking
IDENTITY_LINK_SERVICE_SECRET=
IDENTITY_PAIRING_TOKEN_EXPIRES_MINUTES=10
# Failed-attempt lockout on pairing-code redemption, per (channel, redeeming
# identity). This is the brute-force control, not the per-IP rate limiter: both
# bots relay every user from one IP, so that limit is sized for a population.
# NOTE: in-process state, so a multi-instance deployment multiplies the
# effective allowance by the instance count.
IDENTITY_PAIRING_LOCKOUT_ENABLED=true
IDENTITY_PAIRING_MAX_FAILED_ATTEMPTS=6
IDENTITY_PAIRING_LOCKOUT_WINDOW_MINUTES=15
IDENTITY_PAIRING_LOCKOUT_MINUTES=15


# Future virtual account pipeline (disabled by default)
VIRTUAL_ACCOUNTS_ENABLED=false
VIRTUAL_ACCOUNT_REQUESTS_ENABLED=false
VIRTUAL_ACCOUNT_PROVIDER=mock

# Bridge virtual account adapter (keep disabled until approved)
BRIDGE_VIRTUAL_ACCOUNTS_ENABLED=false
BRIDGE_VIRTUAL_ACCOUNT_DESTINATION_CURRENCY=usdc
BRIDGE_VIRTUAL_ACCOUNT_DESTINATION_PAYMENT_RAIL=base
BRIDGE_VIRTUAL_ACCOUNT_DESTINATION_ADDRESS=
BRIDGE_VIRTUAL_ACCOUNT_BRIDGE_WALLET_ID=
BRIDGE_VIRTUAL_ACCOUNT_DEVELOPER_FEE_PERCENT=0.0

# Ace / Sivan AI support brain
ACE_PROVIDER=remote
SIVAN_AI_API_URL=https://api.sivantech.online/api/sivan-ai
SIVAN_AI_API_KEY=
SIVAN_AI_TIMEOUT_MS=3500
SIVAN_AI_FALLBACK_ENABLED=true
