# Sivan Payments API — TEST lane (Render)
APP_ENV=staging
PORT=10000
APP_URL=https://sivan-payments-api-test.onrender.com
CORS_ORIGIN=https://sivan-payments-user-test.vercel.app,https://sivan-payments-admin-test.vercel.app
LOG_LEVEL=info

# Admin / auth
ADMIN_API_KEY=
USER_JWT_SECRET=
USER_JWT_EXPIRES_MINUTES=60
AUTH_OTP_EXPIRES_MINUTES=10
AUTH_DEV_SHOW_OTP=true
AUTH_REQUIRE_USER=true

# Email provider
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="Sivan <no-reply@sivan.local>"

# Error monitoring
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=0

# Database
DATABASE_PROVIDER=postgres
DATABASE_URL=
DATABASE_FILE=.data/sivan-payments-test.json

# Bridge sandbox
BRIDGE_MOCK_MODE=false
DEFAULT_OFFRAMP_PROVIDER=bridge
BRIDGE_BASE_URL=https://api.sandbox.bridge.xyz/v0
BRIDGE_API_KEY=
BRIDGE_WEBHOOK_PUBLIC_KEY=
WEBHOOK_MAX_AGE_MS=600000

# Fees / costs
SIVAN_OFFRAMP_FEE_PERCENT=1.25
BRIDGE_OFFRAMP_COST_PERCENT=0.5
BRIDGE_KYC_COST_USD=2
BRIDGE_KYB_COST_USD=10
