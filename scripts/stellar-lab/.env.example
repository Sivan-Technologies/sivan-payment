# ─────────────────────────────────────────────────────────────────────────────
# Sivan Stellar Lab, environment template
#
#     cp .env.example .env
#
# Every value below is REQUIRED by the script that uses it. This lab has no
# defaults and no fallbacks: a missing variable stops the run with a message
# naming it.
#
# The URLs here are documentation, not configuration. They are the values you
# are most likely to want, written down once so nobody has to guess. Nothing in
# the lab's source code contains a URL, and `npm run preflight` fails the run if
# one appears.
#
# Why that rule is absolute: a default endpoint is invisible when it is wrong.
# A script that silently falls back to a built-in Horizon URL keeps working
# after someone repoints the lab, and the output still looks correct. The
# mistake only surfaces as a transaction submitted to a network nobody intended.
#
# TESTNET ONLY. Never put a key here that controls real funds.
# ─────────────────────────────────────────────────────────────────────────────


# ── STELLAR NETWORK ──────────────────────────────────────────────────────────
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Mixed into every signature, so it must match the network exactly.
#   testnet  Test SDF Network ; September 2015
#   public   Public Global Stellar Network ; September 2015
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Circle's USDC issuer on Stellar testnet. Verify before use:
#   curl "$STELLAR_HORIZON_URL/accounts/$STELLAR_USDC_ISSUER"
STELLAR_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
STELLAR_USDC_ASSET_CODE=USDC


# ── LAB ACTORS ───────────────────────────────────────────────────────────────
# Master seed for deterministic Service Agreement derivation:
#   seed32 = SHA256(masterSeed + ":" + agreementId)
#
# Anyone holding this seed can derive every agreement account, so in production
# it lives in an HSM and never reaches a process like this one.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LAB_MASTER_SEED=

# Funds and fee-sponsors lab transactions. Fund at https://friendbot.stellar.org
#   node -e "const{Keypair}=require('@stellar/stellar-sdk');const k=Keypair.random();console.log(k.publicKey(),k.secret())"
LAB_SPONSOR_SECRET=

# Payout destinations. Both need a USDC trustline before they can receive.
LAB_WORKER_ADDRESS=
LAB_TREASURY_ADDRESS=


# ── CIRCLE CCTP ──────────────────────────────────────────────────────────────
# Source chain the USDC is burned on.
CCTP_SOURCE_RPC_URL=

# Circle domain ids. These are protocol constants, not addresses:
#   0 Ethereum   1 Avalanche   2 OP   3 Arbitrum   6 Base   7 Polygon
# Confirm Stellar's id against Circle's current documentation.
CCTP_SOURCE_DOMAIN=6
CCTP_DESTINATION_DOMAIN=

# TokenMessenger on the source chain. Read symbol/owner back before trusting it.
CCTP_TOKEN_MESSENGER_ADDRESS=

CCTP_ATTESTATION_API_URL=https://iris-api-sandbox.circle.com


# ── MONEYGRAM ────────────────────────────────────────────────────────────────
MONEYGRAM_API_BASE_URL=https://sandboxapi.moneygram.com
MONEYGRAM_PARTNER_ID=
MONEYGRAM_API_KEY=

# MoneyGram's RSA public key, PEM. Newlines as \n on a single line.
MONEYGRAM_WEBHOOK_PUBLIC_KEY=

# The host MoneyGram calls. It is signed into the digest
#   `${unixSeconds}.${host}.${rawBody}`
# so a mismatch here fails verification even with a correct key. If you tunnel,
# this is the public tunnel host, not localhost.
MONEYGRAM_WEBHOOK_HOST=
MONEYGRAM_WEBHOOK_PORT=4402
