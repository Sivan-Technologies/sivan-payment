# App
APP_ENV=development
PORT=3000
APP_URL=http://localhost:3000
CORS_ORIGIN=*
LOG_LEVEL=info

# Error monitoring
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_MAX_PER_MINUTE=120
RATE_LIMIT_ADMIN_MAX_PER_MINUTE=300
RATE_LIMIT_WEBHOOK_MAX_PER_MINUTE=300
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_START_MAX=5
RATE_LIMIT_AUTH_VERIFY_MAX=20
ADMIN_API_KEY=
USER_JWT_SECRET=
USER_JWT_EXPIRES_MINUTES=60
AUTH_OTP_EXPIRES_MINUTES=10
AUTH_DEV_SHOW_OTP=true
AUTH_REQUIRE_USER=true
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="Sivan <no-reply@sivantech.online>"
LEGAL_TERMS_VERSION=2026-07-14
LEGAL_PRIVACY_VERSION=2026-07-14
LEGAL_RISK_DISCLOSURE_VERSION=2026-07-14

# Provider mode
# false = call Bridge sandbox/production API. Keep false for real user verification.
# true = local tests/development only; never use for hosted test/live onboarding.
BRIDGE_MOCK_MODE=false
DEFAULT_OFFRAMP_PROVIDER=bridge

# Bridge
# Sandbox base URL is commonly https://api.sandbox.bridge.xyz/v0
# Production base URL is https://api.bridge.xyz/v0
BRIDGE_BASE_URL=https://api.sandbox.bridge.xyz/v0
BRIDGE_API_KEY=

# Bridge webhook endpoint public key, returned when you create a webhook endpoint.
# Required for production webhook signature verification.
BRIDGE_WEBHOOK_PUBLIC_KEY=
BRIDGE_WEBHOOK_ID=
WEBHOOK_MAX_AGE_MS=600000

# Sivan user-facing fee and Bridge cost assumptions.
SIVAN_OFFRAMP_FEE_PERCENT=1.25
BRIDGE_OFFRAMP_COST_PERCENT=0.5
BRIDGE_KYC_COST_USD=2
BRIDGE_KYB_COST_USD=10
CUSTOMER_ACQUISITION_COST_USD=0

# Database
# Use json for local file storage or postgres for Neon/Postgres.
DATABASE_PROVIDER=json
DATABASE_URL=
DATABASE_FILE=.data/sivan-offramp.json

# Support notifications and attachments
SUPPORT_NOTIFICATION_EMAIL=
SUPPORT_UPLOAD_PROVIDER=disabled
SUPPORT_ATTACHMENT_MAX_BYTES=10485760
R2_ENDPOINT=
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
POSTGRES_SLOW_QUERY_MS=750

# Shared customer identity linking
IDENTITY_LINK_SERVICE_SECRET=
IDENTITY_PAIRING_TOKEN_EXPIRES_MINUTES=10
# Failed-attempt lockout on pairing-code redemption, per (channel, redeeming
# identity). This is the brute-force control, not the per-IP rate limiter: both
# bots relay every user from one IP, so that limit is sized for a population.
# NOTE: in-process state, so a multi-instance deployment multiplies the
# effective allowance by the instance count.
IDENTITY_PAIRING_LOCKOUT_ENABLED=true
IDENTITY_PAIRING_MAX_FAILED_ATTEMPTS=6
IDENTITY_PAIRING_LOCKOUT_WINDOW_MINUTES=15
IDENTITY_PAIRING_LOCKOUT_MINUTES=15
SIVAN_FEE_WALLET_SOLANA=Faj6u5v1phTw1zwsKUPiqB82idj3wdn8JCSm3Un4KFEu
SIVAN_FEE_WALLET_CELO=0xd62D8aD1EE242745959221b5d020FAf20b41d14A


# Future virtual account pipeline (disabled by default)
VIRTUAL_ACCOUNTS_ENABLED=false
VIRTUAL_ACCOUNT_REQUESTS_ENABLED=false
VIRTUAL_ACCOUNT_PROVIDER=mock

# Bridge virtual account adapter (keep disabled until approved)
BRIDGE_VIRTUAL_ACCOUNTS_ENABLED=false
BRIDGE_VIRTUAL_ACCOUNT_DESTINATION_CURRENCY=usdc
BRIDGE_VIRTUAL_ACCOUNT_DESTINATION_PAYMENT_RAIL=base
BRIDGE_VIRTUAL_ACCOUNT_DESTINATION_ADDRESS=
BRIDGE_VIRTUAL_ACCOUNT_BRIDGE_WALLET_ID=
BRIDGE_VIRTUAL_ACCOUNT_DEVELOPER_FEE_PERCENT=0.0

# Ace / Sivan AI support brain
# local = built-in deterministic answers; remote = call sivan-ai through Cloudflare Worker.
ACE_PROVIDER=local
SIVAN_AI_API_URL=https://test-sivan.sivantech.online/api/sivan-ai
SIVAN_AI_API_KEY=
SIVAN_AI_TIMEOUT_MS=3500
SIVAN_AI_FALLBACK_ENABLED=true

# ─────────────────────────────────────────────────────────────────────────────
# BREET — primary NGN provider (https://docs.breet.io)
# ─────────────────────────────────────────────────────────────────────────────
# From the Breet dashboard: Developers → API Credentials.
# The App Secret is a password. Never commit it, never log it.
BREET_APP_ID=
BREET_APP_SECRET=

# REQUIRED on every request. Breet rejects a missing or invalid value outright.
# development = testnet assets, $1 minimums. production = real money.
BREET_ENV=development

# Dashboard: Settings → For Developer → Webhook Verification Secret Key.
# Sent by Breet as the x-webhook-secret header. Sivan FAILS CLOSED without it:
# /api/webhooks/breet rejects everything rather than trusting an unsigned body.
BREET_WEBHOOK_SECRET=

# Point the Breet dashboard webhook at:
#   https://<your-api>/api/webhooks/breet

# Asset to quote and generate deposit addresses for, from GET /trades/assets.
# NOTE testnet and mainnet ids are DIFFERENT strings for the same asset, e.g.
# Solana USDC is SOL_USDC_JKVK on testnet and SOL_USDC_PTHX on mainnet. Using
# the wrong one addresses a different asset entirely. Leave blank to let
# breet-networks.ts resolve it per (network, asset, environment) — preferred.
BREET_DEFAULT_ASSET_ID=

# On-ramp destination network, in SIVAN's vocabulary (solana, ethereum, base),
# NOT Breet's (SOL, ERC20). breet-networks.ts translates and refuses pairs Breet
# cannot service. Enabled + on-ramp capable today: solana, ethereum.
# Base is off-ramp only — Breet publishes no Base withdrawal.
BREET_DEFAULT_NETWORK=solana

# Breet's platform fee, confirmed by their team: 0.5%, charged ON TOP of the
# rate rather than baked into the spread. This is a COST to Sivan, not revenue,
# and is reported separately from Sivan's margin on every quote.
BREET_FEE_PERCENT=0.5

# Optional fallbacks for auto-settlement when an order carries no bank details.
BREET_DEFAULT_BANK_ID=
BREET_DEFAULT_ACCOUNT_NUMBER=
BREET_DEFAULT_RECIPIENT_ADDRESS=

# ─────────────────────────────────────────────────────────────────────────────
# SIVAN MARGIN ON THE NGN RAIL
# ─────────────────────────────────────────────────────────────────────────────
# Sivan's own margin, separate from the Bridge on/off-ramp percentages, because
# the NGN rail has a different provider, different flows and different
# competition. Sharing one number means repricing Bridge silently reprices naira.
#
# 0 means "NOT SET", not "no fee" — the flow falls back to the Bridge
# percentage. Defaulting to zero would silently drop the margin to nothing.
#
# The provider's fee is added ON TOP of these. At 1.0% here plus Breet's 0.5%,
# a user sending NGN 100,000 pays NGN 1,500 total: NGN 500 to Breet (cost),
# NGN 1,000 to Sivan (revenue).
#
# Also settable at runtime via PUT /api/admin/fees/settings, which overrides
# these — they are only the bootstrap defaults.
SIVAN_NGN_ONRAMP_FEE_PERCENT=1.0
SIVAN_NGN_OFFRAMP_FEE_PERCENT=1.0
# NGN off-ramp revenue path:
#   sivan_fee_wallet = transparent quote fee collected to SIVAN_FEE_WALLET_SOLANA
#   breet_markup     = Breet markup handles revenue; no Sivan wallet fee
#   disabled         = no Sivan revenue
NGN_OFFRAMP_REVENUE_MODE=sivan_fee_wallet

# Naira floor per transaction. A percentage of a small transfer does not cover
# the fixed cost of processing it. 0 = no floor.
SIVAN_NGN_MINIMUM_FEE_NGN=0

# ── BVN / Level 2 identity verification ─────────────────────────────────────
# Which vendor answers a BVN check: mock | monnify | flutterwave | identifyorg
#
# identifyorg is the working provider. Monnify has no live key issued to this
# account, and Flutterwave's only functioning path is v2 - a direct lookup with
# no consent step, which is what the CBN expects a merchant NOT to do.
#
# When more than one vendor is configured the others become a failover chain,
# tried only when the preferred one ERRORS. A verdict is never retried against
# another vendor - see failover-kyc-level.provider.ts for why that is the whole
# safety property.
KYC_LEVEL_PROVIDER=identifyorg

# One header, no OAuth step. Test keys (io_test_...) ignore the phone_number
# requirement; live keys (io_live_...) require it.
#
# ⚠  IN PRODUCTION THIS MUST BE AN io_live_ KEY.
#
# Measured against their sandbox: a test key ECHOES BACK WHATEVER NAMES YOU
# SEND and answers match:true with confidence_score 98 every single time.
# Sending first_name "Wrong" / last_name "Person" against any eleven digits
# returns a 98% match for Wrong Person. There is no input that fails.
#
# So a test key here would grant Level 2 - a NGN 5,000,000 ceiling - to anyone,
# and it would not look like an outage: the response is a well-formed 200 with
# a high score. The provider refuses any response flagged is_test when
# APP_ENV=production, but do not rely on that as the plan; set a live key.
IDENTIFYORG_BASE_URL=https://api.identifyorg.com
IDENTIFYORG_API_KEY=

# Their BVN response carries BOTH match (boolean) and confidence_score (0-100).
# A match below this score is held for REVIEW rather than granted, because
# Level 2 raises a user's ceiling to NGN 5,000,000 and a weak cross-match is
# not proof of identity. Raise this, never lower it silently.
IDENTIFYORG_MIN_CONFIDENCE=80
