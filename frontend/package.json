{
  "name": "sivan-payments-user",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Premium React + TypeScript user frontend for Sivan Payments.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc -b --pretty",
    "test:rails": "tsx scripts/test-rails.ts",
    "test:ngn-bank": "tsx scripts/test-ngn-bank.ts",
    "test:verification-path": "tsx scripts/test-verification-path.ts",
    "lint": "eslint .",
    "lint:ci": "eslint . --max-warnings 94"
  },
  "dependencies": {
    "@sentry/react": "^10.65.0",
    "@vitejs/plugin-react": "latest",
    "qrcode-generator": "^2.0.4",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript-eslint": "^8.66.0"
  },
  "engines": {
    "node": ">=20"
  }
}